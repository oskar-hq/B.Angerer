# Bettina Angerer Consulting, Apache-Konfiguration für www.bettina-angerer.de
# Gilt nur auf einem Apache-Webhosting (z. B. dem bisherigen Hoster der WordPress-Seite).
# GitHub Pages ignoriert diese Datei, dort gibt es keine 301-Weiterleitungen.

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Immer https und www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.bettina-angerer.de%{REQUEST_URI} [R=301,L]

# --- Alte WordPress-Seiten auf die passenden neuen Seiten (301, Rankings bleiben erhalten)
RewriteRule ^projektstrategie/?$ /leistungen/strategie/ [R=301,L]
RewriteRule ^service-engineering/?$ /leistungen/strategie/ [R=301,L]
RewriteRule ^unternehmensnachfolge/?$ /leistungen/strategie/ [R=301,L]
RewriteRule ^marketing-und-vertrieb/?$ /leistungen/vertrieb/ [R=301,L]
RewriteRule ^dienstleistungen/?$ /leistungen/ [R=301,L]
RewriteRule ^bildungsallianz/?$ /leistungen/coaching/ [R=301,L]
RewriteRule ^bvmw/?$ /ueber-mich/ [R=301,L]
RewriteRule ^unterstuetzung-oberfranken-regio-bayreuth-stadt/?$ /ueber-mich/ [R=301,L]
RewriteRule ^kontaktdaten/?$ /kontakt/ [R=301,L]
RewriteRule ^versteckte-steuererhoehung-durch-kurzarbeitergeld/?$ /leistungen/strategie/ [R=301,L]
RewriteRule ^die-zeit-wird-knapp/?$ / [R=301,L]
# /ueber-mich/, /kontakt/, /impressum/ und /datenschutz/ behalten ihre Adresse.

# Adressen aus den Entwürfen der neuen Seite
RewriteRule ^ueber-bettina/?$ /ueber-mich/ [R=301,L]
RewriteRule ^engagement/?$ /ueber-mich/ [R=301,L]
RewriteRule ^leistungen/personal/?$ /leistungen/coaching/ [R=301,L]
RewriteRule ^leistungen/finanzierung/?$ /leistungen/strategie/ [R=301,L]

# --- Blog von 2020 bis 2022: bewusst entfernt (410 = dauerhaft weg)
RewriteRule ^bettina-angerer-blog(/.*)?$ - [G,L]
RewriteRule ^wp-(admin|login|content|includes)(/.*)?$ - [G,L]
RewriteRule ^feed/?$ - [G,L]
RewriteRule ^(post|page|category|post_tag|author)-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
</IfModule>

# Partials und Bauskript nicht ausliefern
<FilesMatch "^(build\.py|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(partials|content|notizen)/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|webp|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
